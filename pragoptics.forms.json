              "type": "text",
              "required": false
            },
            {
              "key": "topic",
              "label": "What is this about?",
              "type": "text",
              "required": true,
              "options": [
                "Work with us, general",
                "Instrumentation and field work",
                "Technical training",
                "Control logic, PLC or DCS",
                "Custom hardware or a print run",
                "Software, APIs, or PragOptics",
                "Refer a project",
                "A problem with this website",
                "Something else"
              ]
            },
            {
              "key": "topicOther",
              "label": "Tell us what it is about (only when What is this about is Something else)",
              "type": "text",
              "required": false
