{
  "forms": [
    {
      "install": "6e1d99e5c54888d6",
      "name": "Submit a Break-In",
      "actions": [
        {
          "name": "send_message",
          "label": "Submit a break-in",
          "description": "A break-in: an instrument, measurement or control problem on the visitor's site that a Bridges Industrial specialist takes up by email, free. Use it when something is misbehaving now (a reading, a loop, a transmitter, a valve, a PLC) and the visitor wants help with it.",
          "params": [
            {
              "key": "name",
              "label": "Name",
              "type": "text",
              "required": true
            },
            {
              "key": "company",
              "label": "Company",
              "type": "text",
              "required": false
            },
            {
              "key": "email",
              "label": "Email",
              "type": "email",
              "required": true
            },
            {
              "key": "phone",
              "label": "Phone",
              "type": "text",
              "required": false
            },
            {
              "key": "sector",
              "label": "Sector",
              "type": "text",
              "required": true,
              "options": [
                "Oil & Gas — Upstream",
                "Oil & Gas — Midstream",
                "Oil & Gas — Downstream",
                "Refining",
                "Petrochemical & Chemical",
                "Power Generation & Utilities",
                "Water & Wastewater",
                "Food & Beverage",
                "Pharmaceutical & Life Sciences",
                "Pulp & Paper",
                "Metals & Mining",
                "Manufacturing & Discrete",
                "Marine & Offshore",
                "Agriculture",
                "Building & Facilities",
                "Other"
              ]
            },
            {
              "key": "sectorOther",
              "label": "Your sector (only when Sector is Other)",
              "type": "text",
              "required": false
            },
            {
              "key": "measuring",
              "label": "What is it measuring?",
              "type": "text",
              "required": true,
              "options": [
                "Level",
                "Flow",
                "Pressure",
                "Temperature",
                "Analytical (pH, conductivity, analyzer)",
                "Weight or density",
                "Control logic (PLC / DCS)",
                "Not sure",
                "Something else"
              ]
            },
            {
              "key": "product",
              "label": "Product or medium",
              "type": "text",
              "required": true
            },
            {
              "key": "when",
              "label": "When does it happen?",
              "type": "text",
              "required": true,
              "options": [
                "All the time, since it started",
                "Only on a certain shift or time of day",
                "Only in certain weather or ambient conditions",
                "Only at certain process conditions (low level, low flow, startup, high rate)",
                "Only after a specific activity (a wash, a transfer, a batch change)",
                "Since a specific change (new product, new device, recent work)",
                "Intermittent, no pattern found yet",
                "Not sure"
              ]
            },
            {
              "key": "around",
              "label": "What happens around this equipment?",
              "type": "text",
              "required": false
            },
            {
              "key": "issue",
              "label": "The issue",
              "type": "textarea",
              "required": true
            },
            {
              "key": "text_ok",
              "label": "Text me instead: permission to reply by text to the phone given",
              "type": "boolean",
              "required": false
            }
          ]
        }
      ]
    },
    {
      "install": "ee7c0bfaf726bbec",
      "name": "Work With Us",
      "actions": [
        {
          "name": "send_message",
